# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# --- Vaultwarden ---
# Public URL clients will use to reach Vaultwarden. Must be HTTPS in practice
# (Web Crypto API requires a secure context) -- terminate TLS at your VPN
# gateway / reverse proxy in front of the 127.0.0.1:8000 port this compose
# file exposes.
DOMAIN=https://vault.example.internal

# --- Authentik SSO ---
# Authentik's issuer URL for the OAuth2/OIDC provider you create, e.g.
# https://authentik.example.internal/application/o/vaultwarden/
# Vaultwarden appends /.well-known/openid-configuration itself -- don't add it here.
SSO_AUTHORITY=https://authentik.example.internal/application/o/vaultwarden/

# From the Authentik OAuth2/OIDC provider you create (see README).
SSO_CLIENT_ID=changeme
SSO_CLIENT_SECRET=changeme

# --- Key Connector ---
# Org name shown to users during Key Connector enrollment.
KEY_CONNECTOR_ORG_NAME=My Homelab

# Base64-encoded 32-byte AES key. Generate with: openssl rand -base64 32
# Back this up like you would a master password -- losing it permanently
# locks out every SSO/Key-Connector user.
KC_ENCRYPTION_KEY=changeme
